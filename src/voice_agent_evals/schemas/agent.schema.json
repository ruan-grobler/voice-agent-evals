{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "An agent version under test: prompt template plus model settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "adapter", "prompt", "model"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "adapter": {"enum": ["claude"]},
    "prompt": {"type": "string", "description": "Prompt template file, relative to agents/."},
    "model": {"type": "string", "pattern": "^claude-"},
    "effort": {"enum": ["low", "medium", "high", "xhigh", "max"], "default": "low"},
    "max_tokens": {"type": "integer", "minimum": 256, "maximum": 64000, "default": 4096},
    "max_tool_rounds": {"type": "integer", "minimum": 1, "maximum": 10, "default": 4}
  }
}
