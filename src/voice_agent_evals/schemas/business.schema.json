{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Business profile for an agent under test (fictional businesses only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "kind",
    "synthetic",
    "address",
    "phone",
    "email",
    "hours",
    "slot_minutes",
    "reference_prefix",
    "offerings",
    "policies",
    "escalation_promise",
    "privacy_notice",
    "booking_guide",
    "booking_tools",
    "escalation_tool",
    "tools_file"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "kind": {
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "description": "Must be true: profiles are fictional."
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "pattern": "@[a-z0-9.-]*example\\.com$"
    },
    "hours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monday",
        "tuesday",
        "wednesday",
        "thursday",
        "friday",
        "saturday",
        "sunday"
      ],
      "patternProperties": {
        "^(monday|tuesday|wednesday|thursday|friday|saturday|sunday)$": {
          "type": "string",
          "pattern": "^(closed|([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9])$"
        }
      }
    },
    "slot_minutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 120
    },
    "reference_prefix": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}$"
    },
    "offerings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "price"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "sizes": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "unit_price": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "specials": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "emergencies": {
      "type": "string"
    },
    "escalation_promise": {
      "type": "string"
    },
    "privacy_notice": {
      "type": "string"
    },
    "booking_guide": {
      "type": "string"
    },
    "booking_tools": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      }
    },
    "escalation_tool": {
      "type": "string"
    },
    "tools_file": {
      "type": "string"
    },
    "offerings_label": {
      "type": "string"
    }
  }
}
