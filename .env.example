# Copy to .env (never commit .env) and export before live runs.
# Replay mode (the default, and what CI uses) needs none of these.

# Needed only for `make record`, `make live` and `make calibrate-live`.
ANTHROPIC_API_KEY=

# Optional model overrides. Defaults are shown.
# The agent model is set per prompt in agents/*.yaml.
VAE_CALLER_MODEL=claude-opus-5-5
VAE_JUDGE_MODEL=claude-sonnet-5-5

# Optional hard stop for live runs, in US dollars. Default 5.00.
VAE_BUDGET_USD=5.00
