[
  {
    "name": "check_availability",
    "description": "List up to four open appointment times on one date. Call this before offering or booking a time.",
    "input_schema": {
      "type": "object",
      "properties": {
        "date": {"type": "string", "format": "date", "description": "Date to check, YYYY-MM-DD."},
        "part_of_day": {"type": "string", "enum": ["morning", "afternoon", "any"], "description": "Optional filter. Morning is before 12:00."}
      },
      "required": ["date"],
      "additionalProperties": false
    }
  },
  {
    "name": "create_booking",
    "description": "Book an appointment. Only call this once the caller has said yes to the date and time.",
    "input_schema": {
      "type": "object",
      "properties": {
        "patient_name": {"type": "string", "minLength": 2, "maxLength": 80},
        "phone": {"type": "string", "pattern": "^\\+27[0-9]{9}$", "description": "Callback number in E.164 format, for example +27000000000."},
        "date": {"type": "string", "format": "date", "description": "YYYY-MM-DD."},
        "time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "description": "24 hour time, HH:MM."},
        "reason": {"type": "string", "minLength": 2, "maxLength": 120, "description": "Short reason for the visit, for example check-up and clean."},
        "notes": {"type": "string", "maxLength": 300, "description": "Optional notes for the team."}
      },
      "required": ["patient_name", "phone", "date", "time", "reason"],
      "additionalProperties": false
    }
  },
  {
    "name": "find_booking",
    "description": "Find a patient's upcoming appointments by phone number, or by full name if they cannot give the number.",
    "input_schema": {
      "type": "object",
      "properties": {
        "patient_name": {"type": "string", "minLength": 2, "maxLength": 80},
        "phone": {"type": "string", "pattern": "^\\+27[0-9]{9}$"}
      },
      "required": ["patient_name"],
      "additionalProperties": false
    }
  },
  {
    "name": "reschedule_booking",
    "description": "Move an existing appointment to a new free date and time.",
    "input_schema": {
      "type": "object",
      "properties": {
        "booking_reference": {"type": "string", "pattern": "^SSD-[0-9]{4}$"},
        "new_date": {"type": "string", "format": "date"},
        "new_time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}
      },
      "required": ["booking_reference", "new_date", "new_time"],
      "additionalProperties": false
    }
  },
  {
    "name": "cancel_booking",
    "description": "Cancel an existing appointment.",
    "input_schema": {
      "type": "object",
      "properties": {
        "booking_reference": {"type": "string", "pattern": "^SSD-[0-9]{4}$"},
        "reason": {"type": "string", "maxLength": 200}
      },
      "required": ["booking_reference"],
      "additionalProperties": false
    }
  },
  {
    "name": "take_message",
    "description": "Leave a message for the practice team when something cannot be handled on the call.",
    "input_schema": {
      "type": "object",
      "properties": {
        "caller_name": {"type": "string", "minLength": 2, "maxLength": 80},
        "phone": {"type": "string", "pattern": "^\\+27[0-9]{9}$"},
        "message": {"type": "string", "minLength": 2, "maxLength": 500}
      },
      "required": ["caller_name", "phone", "message"],
      "additionalProperties": false
    }
  },
  {
    "name": "escalate_to_human",
    "description": "Hand the call to a person: creates a callback task for the practice manager, or an urgent one for the dentist on call.",
    "input_schema": {
      "type": "object",
      "properties": {
        "reason": {"type": "string", "enum": ["complaint", "clinical_urgent", "caller_requested_human", "other"]},
        "urgency": {"type": "string", "enum": ["normal", "high"]},
        "summary": {"type": "string", "minLength": 10, "maxLength": 400, "description": "What the person calling back needs to know."},
        "caller_name": {"type": "string", "maxLength": 80},
        "callback_number": {"type": "string", "pattern": "^\\+27[0-9]{9}$"}
      },
      "required": ["reason", "urgency", "summary", "callback_number"],
      "additionalProperties": false
    }
  },
  {
    "name": "end_call",
    "description": "Hang up. Say goodbye first.",
    "input_schema": {
      "type": "object",
      "properties": {
        "reason": {"type": "string", "maxLength": 120}
      },
      "required": ["reason"],
      "additionalProperties": false
    }
  }
]
