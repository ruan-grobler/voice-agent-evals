[
  {
    "name": "check_table_availability",
    "description": "Check whether a table is free for a party at a date and time.",
    "input_schema": {
      "type": "object",
      "properties": {
        "date": {"type": "string", "format": "date", "description": "YYYY-MM-DD."},
        "time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "description": "24 hour time, HH:MM."},
        "party_size": {"type": "integer", "minimum": 1, "maximum": 12}
      },
      "required": ["date", "time", "party_size"],
      "additionalProperties": false
    }
  },
  {
    "name": "create_table_booking",
    "description": "Book a table. Only call this once the caller has said yes to the details.",
    "input_schema": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 2, "maxLength": 80},
        "phone": {"type": "string", "pattern": "^\\+27[0-9]{9}$", "description": "Callback number in E.164 format, for example +27000000000."},
        "date": {"type": "string", "format": "date"},
        "time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
        "party_size": {"type": "integer", "minimum": 1, "maximum": 12},
        "notes": {"type": "string", "maxLength": 300}
      },
      "required": ["name", "phone", "date", "time", "party_size"],
      "additionalProperties": false
    }
  },
  {
    "name": "place_collection_order",
    "description": "Send a collection order to the kitchen tablet.",
    "input_schema": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 2, "maxLength": 80},
        "phone": {"type": "string", "pattern": "^\\+27[0-9]{9}$"},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "item": {"type": "string", "enum": ["Margherita", "Pepperoni", "Hawaiian", "Four Cheese", "Garden Veg", "Garlic bread", "Soft drink (can)"]},
              "size": {"type": "string", "enum": ["medium", "large"]},
              "quantity": {"type": "integer", "minimum": 1, "maximum": 10}
            },
            "required": ["item", "quantity"],
            "additionalProperties": false
          }
        },
        "collection_time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "description": "24 hour time today, HH:MM."},
        "notes": {"type": "string", "maxLength": 300}
      },
      "required": ["name", "phone", "items", "collection_time"],
      "additionalProperties": false
    }
  },
  {
    "name": "take_message",
    "description": "Leave a message for the team when something cannot be handled on the call.",
    "input_schema": {
      "type": "object",
      "properties": {
        "caller_name": {"type": "string", "minLength": 2, "maxLength": 80},
        "phone": {"type": "string", "pattern": "^\\+27[0-9]{9}$"},
        "message": {"type": "string", "minLength": 2, "maxLength": 500}
      },
      "required": ["caller_name", "phone", "message"],
      "additionalProperties": false
    }
  },
  {
    "name": "escalate_to_human",
    "description": "Hand the call to a person: creates a callback task for the manager.",
    "input_schema": {
      "type": "object",
      "properties": {
        "reason": {"type": "string", "enum": ["complaint", "caller_requested_human", "large_group_or_catering", "other"]},
        "urgency": {"type": "string", "enum": ["normal", "high"]},
        "summary": {"type": "string", "minLength": 10, "maxLength": 400, "description": "What the manager needs to know."},
        "caller_name": {"type": "string", "maxLength": 80},
        "callback_number": {"type": "string", "pattern": "^\\+27[0-9]{9}$"}
      },
      "required": ["reason", "urgency", "summary", "callback_number"],
      "additionalProperties": false
    }
  },
  {
    "name": "end_call",
    "description": "Hang up. Say goodbye first.",
    "input_schema": {
      "type": "object",
      "properties": {
        "reason": {"type": "string", "maxLength": 120}
      },
      "required": ["reason"],
      "additionalProperties": false
    }
  }
]
